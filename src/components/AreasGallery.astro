---
import { areas } from '../data/hotelData';
import { ui } from '../i18n/ui';

interface Props {
  lang: 'es' | 'en';
}

const { lang } = Astro.props;
const text = ui[lang];
---

<section class="areas-section section-pad" id={lang === 'es' ? 'amenidades' : 'amenities'} aria-labelledby={`areas-title-${lang}`}>
  <div class="areas-heading">
    <div>
      <p class="eyebrow"><span class="section-number">03</span>{text.areasEyebrow}</p>
      <h2 class="display-title" id={`areas-title-${lang}`}>{text.areasTitle}</h2>
      <p class="areas-description">{text.areasDescription}</p>
    </div>
    <div class="areas-controls" aria-label={text.areasControls}>
      <button class="areas-arrow" type="button" data-gallery-prev aria-label={text.areasPrev} title={text.areasPrev}>
        <span aria-hidden="true">←</span>
      </button>
      <button class="areas-arrow" type="button" data-gallery-next aria-label={text.areasNext} title={text.areasNext}>
        <span aria-hidden="true">→</span>
      </button>
    </div>
  </div>
  <div class="areas-track" data-areas-track tabindex="0" aria-label={text.areasDescription}>
    {areas.map((area, index) => (
      <article class="area-slide">
        <div class="area-image-wrap">
          <img src={area.src} data-fallback={area.fallback} alt={area.alt[lang]} loading={index === 0 ? 'eager' : 'lazy'} />
          <span class="area-index">{String(index + 1).padStart(2, '0')} / {String(areas.length).padStart(2, '0')}</span>
        </div>
        <div class="area-caption"><h3>{area.title[lang]}</h3><span>{area.detail[lang]}</span></div>
      </article>
    ))}
  </div>
  <div class="areas-progress" aria-hidden="true"><span data-gallery-progress></span></div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-areas-track]').forEach((track) => {
    const gallery = track.closest<HTMLElement>('.areas-section');
    const previous = gallery?.querySelector<HTMLButtonElement>('[data-gallery-prev]');
    const next = gallery?.querySelector<HTMLButtonElement>('[data-gallery-next]');
    const progress = gallery?.querySelector<HTMLElement>('[data-gallery-progress]');
    const firstSlide = track.querySelector<HTMLElement>('.area-slide');
    if (!gallery || !previous || !next || !firstSlide) return;

    const updateControls = () => {
      const maxScroll = track.scrollWidth - track.clientWidth;
      previous.disabled = track.scrollLeft <= 2;
      next.disabled = track.scrollLeft >= maxScroll - 2;
      if (progress) {
        const ratio = maxScroll > 0 ? track.scrollLeft / maxScroll : 0;
        progress.style.transform = `scaleX(${Math.max(0.18, 1 - ratio * 0.82)})`;
        progress.style.transformOrigin = 'left';
      }
    };
    const scrollOneCard = (direction: number) => {
      const gap = Number.parseFloat(getComputedStyle(track).columnGap) || 0;
      track.scrollBy({ left: direction * (firstSlide.getBoundingClientRect().width + gap), behavior: 'smooth' });
    };

    previous.addEventListener('click', () => scrollOneCard(-1));
    next.addEventListener('click', () => scrollOneCard(1));
    track.addEventListener('scroll', updateControls, { passive: true });
    window.addEventListener('resize', updateControls);
    updateControls();
  });
</script>
