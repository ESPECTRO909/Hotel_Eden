---
import { siteConfig } from '../data/siteConfig';
import { Menu } from 'lucide-react';
import { ui } from '../i18n/ui';

interface Props {
  lang?: 'es' | 'en';
  languageHref?: string;
}

const { lang = 'es', languageHref: alternateHref } = Astro.props;
const english = lang === 'en';
const text = english ? ui.en : ui.es;
const home = english ? '/en/' : '/';
const languageHref = alternateHref ?? (english ? '/' : '/en/');
const roomsAnchor = english ? 'rooms' : 'habitaciones';
const experienceAnchor = english ? 'experience' : 'experiencia';
const locationAnchor = english ? 'location' : 'ubicacion';
const links = [
  { href: `${home}#${roomsAnchor}`, label: text.navRooms },
  { href: `${home}#${experienceAnchor}`, label: text.navExperience },
  { href: `${home}#${locationAnchor}`, label: text.navLocation },
];
---

<nav class="site-nav" aria-label={english ? 'Main navigation' : 'Navegación principal'}>
  <a class="brand" href={home} aria-label={`${siteConfig.name} · ${english ? 'home' : 'inicio'}`}>
    <span class="brand-mark" aria-hidden="true">E</span>
    <span class="brand-name">{siteConfig.name}</span>
  </a>
  <div class="nav-links">
    {links.map((link) => <a href={link.href}>{link.label}</a>)}
  </div>
  <details class="mobile-nav">
    <summary aria-label={english ? 'Open navigation menu' : 'Abrir menú de navegación'}><Menu size={19} aria-hidden="true" /></summary>
    <div class="mobile-nav-panel">
      {links.map((link) => <a href={link.href}>{link.label}</a>)}
    </div>
  </details>
  <div class="nav-actions">
    <a class="lang-switch" href={languageHref} data-language-switch data-lang={lang} aria-label={english ? 'Cambiar a español' : 'Switch to English'}>
      <span class="lang-thumb" aria-hidden="true"></span>
      <span class="lang-option">ES</span>
      <span class="lang-option">EN</span>
    </a>
    <a class="nav-cta" href={`${home}#${roomsAnchor}`}>
      <span class="nav-cta-label">{text.navCta}</span>
      <span class="nav-cta-compact">{english ? 'Book' : 'Reservar'}</span>
      <span aria-hidden="true">↗</span>
    </a>
  </div>
</nav>

<script>
  document.querySelectorAll<HTMLAnchorElement>('[data-language-switch]').forEach((link) => {
    link.addEventListener('click', (event) => {
      const modified = event.metaKey || event.ctrlKey || event.shiftKey || event.button !== 0;
      const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (modified || reduced) return;
      event.preventDefault();
      link.classList.add('is-switching');
      setTimeout(() => { window.location.href = link.href; }, 260);
    });
  });
</script>
