---
import Layout from '../../../layouts/Layout.astro';
import { rooms, type Room } from '../../../data/hotelData';
import { siteConfig } from '../../../data/siteConfig';
import type { GetStaticPaths } from 'astro';

interface Props {
  room: Room;
}

export const getStaticPaths: GetStaticPaths = () => {
  return rooms.map((room) => ({ params: { slug: room.slug }, props: { room } }));
}

const { room } = Astro.props;
const homeUrl = `/en/?reserva=${room.slug}#rooms`;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'HotelRoom',
  name: room.name.en,
  description: room.description.en,
  occupancy: { '@type': 'QuantitativeValue', maxValue: room.capacity },
  bed: room.beds.en,
  image: room.images.map((image) => image.src),
  offers: { '@type': 'Offer', price: room.price, priceCurrency: siteConfig.currency, availability: 'https://schema.org/LimitedAvailability' },
  containedInPlace: { '@type': 'Hotel', name: siteConfig.name },
};
---

<Layout lang="en" title={`${room.name.en} | Hotel El Eden`} description={room.description.en} image={room.images[0].src} structuredData={schema} alternatePath={`/habitaciones/${room.slug}/`}>
  <article class="room-page">
    <div class="room-page-top"><a class="back-link" href="/en/#rooms">← All rooms</a><span class="eyebrow">{room.eyebrow.en}</span></div>
    <div class="room-page-heading"><div><h1>{room.name.en}</h1><p>{room.description.en}</p></div><div class="room-page-price"><span>FROM</span><strong>${room.price.toLocaleString('en-US')}</strong><small>MXN · per night</small></div></div>
    <div class="room-gallery"><img src={room.images[0].src} data-fallback={room.images[0].fallback} alt={room.images[0].alt.en} /><div>{room.images.slice(1).map((image) => <img src={image.src} data-fallback={image.fallback} alt={image.alt.en} loading="lazy" />)}</div></div>
    <div class="room-page-info"><div><p class="eyebrow">THE SPACE</p><h2>A place to slow down.</h2><p>{room.description.en}</p><div class="room-facts"><span>{room.size} m²</span><span>{room.beds.en}</span><span>Up to {room.capacity} guests</span></div></div><div><p class="eyebrow">INCLUDED</p><ul>{room.amenities.map((amenity) => <li>{amenity.en}</li>)}</ul><p class="eyebrow policy-heading">POLICIES</p><ul>{room.policies.map((policy) => <li>{policy.en}</li>)}</ul></div></div>
    <div class="room-page-book"><div><strong>From ${room.price.toLocaleString('en-US')} MXN</strong><span>per night · estimate shown in request</span></div><a class="button button-dark" href={homeUrl}>Enquire about this room <span aria-hidden="true">↗</span></a></div>
  </article>
</Layout>