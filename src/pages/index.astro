---
import Layout from '../layouts/Layout.astro';
import { faq, rooms } from '../data/hotelData';
import { siteConfig } from '../data/siteConfig';
import { ui } from '../i18n/ui';
import HotelExperience from '../react/HotelExperience';
import AreasGallery from '../components/AreasGallery.astro';

const text = ui.es;
const hotelSchema = {
  '@context': 'https://schema.org',
  '@type': 'Hotel',
  name: siteConfig.name,
  description: text.heroCopy,
  ...(siteConfig.address ? { address: { '@type': 'PostalAddress', streetAddress: siteConfig.address, addressCountry: 'MX' } } : {}),
  checkinTime: siteConfig.checkIn,
  checkoutTime: siteConfig.checkOut,
  priceRange: '$2,150 - $3,650 MXN',
  image: rooms.flatMap((room) => room.images.map((image) => image.src)),
};
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.es.map(({ q, a }) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
};
---

<Layout title="Hotel El Eden | Descansa a tu manera" description={text.heroCopy} structuredData={[hotelSchema, faqSchema]}>
  <section class="hero" aria-labelledby="hero-title">
    <img class="hero-image" src="/images/hero/La-Piedad-1.jpeg.webp" data-fallback="https://images.unsplash.com/photo-1600210492486-724fe5c67fb0?auto=format&fit=crop&w=2200&q=90" alt="Hotel El Eden en La Piedad" fetchpriority="high" />
    <div class="hero-shade"></div>
    <div class="hero-copy">
      <p class="eyebrow eyebrow-light"><span></span>{text.heroKicker}</p>
      <h1 id="hero-title">{text.heroTitle}</h1>
      <p class="hero-description">{text.heroCopy}</p>
      <a class="button button-light" href="#habitaciones">{text.heroExplore}<span aria-hidden="true">↘</span></a>
    </div>
    <div class="hero-caption"><span>{text.heroNote}</span><span class="caption-line"></span><span>{siteConfig.locationShort.toUpperCase()}</span></div>
    <span class="hero-index">01 / 04</span>
  </section>

  <section class="intro section-pad" id="experiencia">
    <div class="intro-label"><span class="section-number">01</span><p class="eyebrow">{text.introLabel}</p></div>
    <div class="intro-body">
      <h2 class="display-title">{text.introTitle.split('\n').map((line) => <span>{line}</span>)}</h2>
      <div class="intro-aside">
        <p>{text.introCopy}</p>
        <a class="text-link" href="#amenidades">{text.amenityTitle}<span aria-hidden="true">↘</span></a>
      </div>
    </div>
    <div class="intro-stamp" aria-hidden="true"><span>H</span><span>·</span><span>E</span></div>
  </section>

  <section class="rooms-section section-pad" id="habitaciones">
    <div class="section-heading">
      <div><p class="eyebrow"><span class="section-number">02</span>{text.roomsLabel}</p><h2 class="display-title">{text.roomsTitle}</h2></div>
      <p class="section-intro">{text.roomsCopy}</p>
    </div>
    <HotelExperience client:load lang="es" rooms={rooms} copy={text} />
  </section>

  <AreasGallery lang="es" />

  <section class="location-section section-pad" id="ubicacion">
    <div class="location-copy">
      <p class="eyebrow"><span class="section-number">04</span>{text.locationLabel}</p>
      <h2 class="display-title">{text.locationTitle.split('\n').map((line) => <span>{line}</span>)}</h2>
      <p class="location-description">{text.locationCopy}</p>
      <div class="address-block"><span>{text.addressLabel}</span><p>{siteConfig.address || text.mapNote}</p></div>
      {siteConfig.directionsUrl && <a class="button button-dark" href={siteConfig.directionsUrl} target="_blank" rel="noreferrer">{text.directions}<span aria-hidden="true">↗</span></a>}
      {!siteConfig.directionsUrl && <p class="setup-note">{text.mapNote}</p>}
    </div>
    <div class="location-visual">
      {siteConfig.mapEmbedUrl ? <iframe src={siteConfig.mapEmbedUrl} title="Mapa de ubicación del Hotel El Eden" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe> : <div class="map-placeholder"><span class="map-grid"></span><span class="map-pin"><span></span></span><span class="map-tag">HOTEL EL EDEN · MÉXICO</span><span class="map-coordinates">{siteConfig.locationShort.toUpperCase()}</span></div>}
    </div>
  </section>

  <section class="faq-section section-pad" id="preguntas">
    <div class="faq-heading"><p class="eyebrow"><span class="section-number">05</span>{text.faqLabel}</p><h2 class="display-title">{text.faqTitle}</h2></div>
    <div class="faq-list">
      {faq.es.map((item, index) => <details class="faq-item"><summary><span class="faq-index">0{index + 1}</span><span>{item.q}</span><span class="faq-toggle" aria-hidden="true">+</span></summary><p>{item.a}</p></details>)}
    </div>
  </section>

  <section class="closing-cta">
    <img src="/images/hero/cierre.webp" data-fallback="https://images.unsplash.com/photo-1600210492486-724fe5c67fb0?auto=format&fit=crop&w=2200&q=85" alt="Luz de tarde en una estancia serena" loading="lazy" />
    <div class="closing-content"><p class="eyebrow eyebrow-light">HOTEL EL EDEN · MÉXICO</p><h2>{text.ctaTitle.split('\n').map((line) => <span>{line}</span>)}</h2><p>{text.ctaCopy}</p><a class="button button-light" href="#habitaciones">{text.ctaButton}<span aria-hidden="true">↗</span></a></div>
  </section>

  <footer class="site-footer">
    <a class="brand footer-brand" href="/" aria-label="Hotel El Eden inicio"><span class="brand-mark">E</span><span class="brand-name">Hotel El Eden</span></a>
    <p>{text.footerLine}</p>
    <div class="footer-meta"><span>© {new Date().getFullYear()} HOTEL EL EDEN</span><a href="/privacidad">{text.privacy}</a><span>{text.rights}</span></div>
  </footer>
</Layout>
