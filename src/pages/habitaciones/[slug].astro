---
import RoomPage from '../../components/RoomPage.astro';
import { rooms, type Room } from '../../data/hotelData';
import type { GetStaticPaths } from 'astro';

interface Props {
  room: Room;
}

export const getStaticPaths: GetStaticPaths = () => {
  return rooms.map((room) => ({ params: { slug: room.slug }, props: { room } }));
}

const { room } = Astro.props;
---

<RoomPage room={room} lang="es" />
